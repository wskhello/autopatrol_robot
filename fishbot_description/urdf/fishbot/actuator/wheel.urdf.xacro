<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:include filename="$(find fishbot_description)/urdf/fishbot/common_inertia.xacro"/>
    <xacro:macro name="wheel_xacro" params="wheel_name xyz ">
        <link name="${wheel_name}_link">
            <visual>
                <origin xyz="0.0 0.0 0.0" rpy="1.57079 0.0 0.0"/><!--沿x轴旋转pi/2-->
                <geometry>
                    <cylinder radius="0.032" length="0.04"/>
                </geometry>
                <material name="yellow">
                    <color rgba="1.0 1.0 0.0 0.8"/>
                </material>
            </visual>
            <collision>
                <origin xyz="0.0 0.0 0.0" rpy="1.57079 0.0 0.0"/><!--沿x轴旋转pi/2-->
                <geometry>
                    <cylinder radius="0.032" length="0.04"/>
                </geometry>
                <material name="yellow">
                    <color rgba="1.0 1.0 0.0 0.8"/>
                </material>
            </collision>
            <xacro:cylinder_inertia m="0.05" r="0.032" h="0.04"/>
        </link>

        <joint name="${wheel_name}_joint" type="continuous">
            <origin xyz="${xyz}" rpy="0.0 0.0 0.0"/>
            <parent link="base_link"/>
            <child link="${wheel_name}_link"/>
            <axis xyz="0 1 0"/><!--轮子绕y轴旋转-->
        </joint>
         
        <gazebo reference = "${wheel_name}_link">
            <material>Gazebo/Yellow</material>
            <mu1 value="20.0"/> <!--切向摩擦系数-->
            <mu2 value="20.0"/> <!--法向摩擦系数--> 
            <kp value="1000000000.0"/> <!--接触刚度系数--> 
            <kd value="1.0"/> <!--阻尼系数--> 
        </gazebo>
    </xacro:macro>
    
 
</robot>